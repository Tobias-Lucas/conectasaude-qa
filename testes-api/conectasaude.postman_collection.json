{
  "info": {
    "name": "ConectaSaude - RF-12 POST /agendamento",
    "description": "Os casos C-01 a C-12 da atividade da Aula Nacional 3, incluindo o C-11b: 15 requisições, 15 asserts. O C-13 (cor e alinhamento do botão) não está aqui de propósito.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "setup - zerar agenda",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/_laboratorio/zerar", "host": ["{{baseUrl}}"], "path": ["_laboratorio", "zerar"] }
      },
      "event": []
    },
    {
      "name": "C-01 agendamento feliz",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"data_agendamento\": \"{{hoje}}\",\n  \"horario\": \"14:00\",\n  \"paciente_id\": \"P-0042\",\n  \"profissional_id\": \"DRA-ANA\"\n}" },
        "url": { "raw": "{{baseUrl}}/agendamento", "host": ["{{baseUrl}}"], "path": ["agendamento"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "// o esperado do C-01, escrito antes do clique",
          "pm.test('C-01 - hoje é aceito (201)', () => {",
          "    pm.response.to.have.status(201);",
          "});",
          "pm.test('C-01 - JSON traz o agendamento', () => {",
          "    const j = pm.response.json();",
          "    pm.expect(j.data_agendamento).to.eql(pm.environment.get('hoje'));",
          "});"
        ] }
      }]
    },
