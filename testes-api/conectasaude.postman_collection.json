      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"data_agendamento\": \"30/11/2026\",\n  \"horario\": \"11:00\",\n  \"paciente_id\": \"P-0099\",\n  \"profissional_id\": \"DRA-ANA\"\n}" },
