    {
      "name": "C-11 WhatsApp 429, cai para SMS",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"data_agendamento\": \"01/12/2026\",\n  \"horario\": \"09:00\",\n  \"paciente_id\": \"P-0042\",\n  \"profissional_id\": \"DRA-ANA\"\n}" },
        "url": { "raw": "{{baseUrl}}/agendamento?simular=whatsapp_429", "host": ["{{baseUrl}}"], "path": ["agendamento"], "query": [{ "key": "simular", "value": "whatsapp_429" }] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('C-11 - WhatsApp indisponível cai para SMS', () => {",
          "    pm.response.to.have.status(201);",
          "    pm.expect(pm.response.json().lembrete.canal).to.eql('sms');",
          "});"
        ] }
      }]
    },
    {
      "name": "C-11b WhatsApp e SMS indisponíveis, contato manual",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"data_agendamento\": \"03/12/2026\",\n  \"horario\": \"09:00\",\n  \"paciente_id\": \"P-0043\",\n  \"profissional_id\": \"DRA-ANA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/agendamento?simular=whatsapp_429,sms_503",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "agendamento"
          ],
          "query": [
            {
              "key": "simular",
              "value": "whatsapp_429,sms_503"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('C-11b - WhatsApp e SMS indisponíveis encaminham para contato manual', () => {",
              "    pm.response.to.have.status(201);",
              "    const lembrete = pm.response.json().lembrete;",
              "    pm.expect(lembrete.canal).to.eql('manual');",
              "    pm.expect(lembrete.estado).to.eql('pendente');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "C-12 texto do lembrete sem especialidade",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"data_agendamento\": \"02/12/2026\",\n  \"horario\": \"09:00\",\n  \"paciente_id\": \"P-0042\",\n  \"profissional_id\": \"DRA-ANA\",\n  \"especialidade\": \"Cardiologia\"\n}" },
        "url": { "raw": "{{baseUrl}}/agendamento", "host": ["{{baseUrl}}"], "path": ["agendamento"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "// o veto do DPO: dado de saúde não vai para a mensagem do paciente",
          "pm.test('C-12 - o texto do lembrete não cita especialidade', () => {",
          "    pm.response.to.have.status(201);",
          "    const texto = pm.response.json().lembrete.texto.toLowerCase();",
          "    pm.expect(texto).to.not.include('cardiolog');",
          "});"
        ] }
      }]
    }
